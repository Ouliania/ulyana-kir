---
import { t, type Locale } from '../i18n/ui';

export interface Crumb {
  label: string;
  /** Omit on current page; required for intermediate links */
  href?: string;
}

interface Props {
  locale: Locale;
  /** Trail after Home (Home always prepended) */
  items: Crumb[];
}

const { locale, items } = Astro.props;
const homeHref = locale === 'ru' ? '/ru/' : '/';
const crumbs: Crumb[] = [{ label: t(locale, 'home'), href: homeHref }, ...items];

const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://www.ulyanaweb.ru';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => {
    const isLast = i === crumbs.length - 1;
    const itemUrl = c.href
      ? (c.href.startsWith('http') ? c.href : `${siteBase}${c.href.startsWith('/') ? '' : '/'}${c.href}`)
      : (isLast ? Astro.url.href : undefined);

    const listItem: Record<string, unknown> = {
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
    };

    if (itemUrl) {
      listItem.item = itemUrl;
    }

    return listItem;
  }),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

<nav class="crumbs" aria-label={t(locale, 'breadcrumbAria')}>
  <ol class="crumbs-list">
    {
      crumbs.map((c, i) => {
        const isLast = i === crumbs.length - 1;
        return (
          <li class="crumbs-item">
            {i > 0 && (
              <span class="crumbs-sep" aria-hidden="true">
                /
              </span>
            )}
            {!isLast && c.href ? (
              <a class="crumbs-link" href={c.href}>
                {c.label}
              </a>
            ) : (
              <span class="crumbs-current" aria-current={isLast ? 'page' : undefined}>
                {c.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs {
    padding: 1rem var(--content-inline) 0;
  }

  .crumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  .crumbs-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .crumbs-sep {
    color: var(--color-text-muted);
    opacity: 0.55;
    user-select: none;
  }

  .crumbs-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .crumbs-link:hover {
    color: var(--color-blue);
  }

  .crumbs-current {
    color: var(--color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-inline-size: min(28rem, 70vw);
  }

  @media (prefers-reduced-motion: reduce) {
    .crumbs-link {
      transition: none;
    }
  }
</style>
