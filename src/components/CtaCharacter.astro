---
// Aurora character — interactive glowing sphere with mood states
// Built from 3 blurred gradient layers (no hard edge — sphere is «painted air»)
---

<div class="cta-char" aria-hidden="true">
  <!-- Layer 1: core color blobs (multiply) -->
  <div class="cc-blob cc-blob--core">
    <div class="cc-blob-inner cc-blob-inner--default"></div>
    <div class="cc-blob-inner cc-blob-inner--green"></div>
    <div class="cc-blob-inner cc-blob-inner--red"></div>
  </div>

  <!-- Layer 2: screen shimmer + white glow -->
  <div class="cc-blob cc-blob--shimmer">
    <div class="cc-blob-inner cc-blob-inner--default"></div>
    <div class="cc-blob-inner cc-blob-inner--green"></div>
    <div class="cc-blob-inner cc-blob-inner--red"></div>
  </div>

  <!-- Layer 3: outer aura -->
  <div class="cc-blob cc-blob--aura">
    <div class="cc-blob-inner cc-blob-inner--default"></div>
    <div class="cc-blob-inner cc-blob-inner--green"></div>
    <div class="cc-blob-inner cc-blob-inner--red"></div>
  </div>

  <!-- Face SVG -->
  <svg class="cta-char-face" viewBox="0 0 100 100" fill="none">
    <g transform-origin="29 30"><path d="M 22 32 Q 28 24 36 32" stroke="white" stroke-width="3" stroke-linecap="round"/></g>
    <g transform-origin="71 30"><path d="M 64 32 Q 72 24 78 32" stroke="white" stroke-width="3" stroke-linecap="round"/></g>
    <circle cx="29" cy="45" r="3.5" fill="white"/>
    <circle cx="71" cy="45" r="3.5" fill="white"/>
    <g transform-origin="53 59"><path d="M 48 52 L 48 66 L 58 66" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
    <g class="char-mouth-set char-mouth-set--default">
      <path d="M38 78 Q50 88 62 78" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
    </g>
    <g class="char-mouth-set char-mouth-set--green">
      <path d="M34 74 Q50 94 66 74" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
    </g>
    <g class="char-mouth-set char-mouth-set--red">
      <path d="M40 86 Q50 84 60 86" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
    </g>
  </svg>
</div>

<style>
  .cta-char {
    --char-size: clamp(180px, 25vw, 350px);
    --look-x: 0;
    --look-y: 0;
    position: relative;
    width: var(--char-size);
    height: var(--char-size);
    flex-shrink: 0;
  }

  /* ============================================
     Blob layers — shared base
     ============================================ */
  .cc-blob {
    position: absolute;
    pointer-events: none;
    transition: transform 0.3s ease-out;
  }

  .cc-blob-inner {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transition: opacity 0.6s ease;
  }

  /* ============================================
     Layer 1 — core color blobs (multiply)
     ============================================ */
  .cc-blob--core {
    inset: 0;
    filter: blur(clamp(28px, 7vw, 50px));
    transform: translateX(calc(var(--look-x, 0) * 4%)) translateY(calc(var(--look-y, 0) * 2%));
  }

  .cc-blob--core .cc-blob-inner--default {
    opacity: 0.95;
    background:
      radial-gradient(circle at 30% 30%, rgba(34, 211, 238, 0.9) 0%, transparent 60%),
      radial-gradient(circle at 70% 60%, rgba(139, 92, 246, 0.7) 0%, transparent 60%),
      radial-gradient(circle at 40% 80%, rgba(59, 130, 246, 0.7) 0%, transparent 60%);
    mix-blend-mode: multiply;
  }

  .cc-blob--core .cc-blob-inner--green {
    opacity: 0;
    background:
      radial-gradient(circle at 30% 30%, rgba(34, 211, 168, 0.9) 0%, transparent 60%),
      radial-gradient(circle at 70% 60%, rgba(92, 231, 184, 0.7) 0%, transparent 60%),
      radial-gradient(circle at 40% 80%, rgba(58, 154, 106, 0.7) 0%, transparent 60%);
    mix-blend-mode: multiply;
  }

  .cc-blob--core .cc-blob-inner--red {
    opacity: 0;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 138, 138, 0.9) 0%, transparent 60%),
      radial-gradient(circle at 70% 60%, rgba(231, 92, 92, 0.7) 0%, transparent 60%),
      radial-gradient(circle at 40% 80%, rgba(192, 57, 43, 0.7) 0%, transparent 60%);
    mix-blend-mode: multiply;
  }

  [data-mood="green"] .cc-blob--core .cc-blob-inner--default { opacity: 0; }
  [data-mood="green"] .cc-blob--core .cc-blob-inner--green   { opacity: 0.95; }
  [data-mood="green"] .cc-blob--core .cc-blob-inner--red     { opacity: 0; }

  [data-mood="red"] .cc-blob--core .cc-blob-inner--default { opacity: 0; }
  [data-mood="red"] .cc-blob--core .cc-blob-inner--green   { opacity: 0; }
  [data-mood="red"] .cc-blob--core .cc-blob-inner--red     { opacity: 0.95; }

  /* ============================================
     Layer 2 — screen shimmer
     ============================================ */
  .cc-blob--shimmer {
    inset: -10%;
    filter: blur(clamp(25px, 7vw, 45px));
    transform: translateX(calc(var(--look-x, 0) * 2%)) translateY(calc(var(--look-y, 0) * 1%));
  }

  .cc-blob--shimmer .cc-blob-inner--default {
    opacity: 0.8;
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.4) 0%, transparent 60%),
      conic-gradient(rgba(196, 181, 253, 0.2) 0%, rgba(103, 232, 249, 0.2) 50%, rgba(196, 181, 253, 0.2) 100%);
    mix-blend-mode: screen;
  }

  .cc-blob--shimmer .cc-blob-inner--green {
    opacity: 0;
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.4) 0%, transparent 60%),
      conic-gradient(rgba(167, 243, 208, 0.2) 0%, rgba(52, 211, 153, 0.2) 50%, rgba(167, 243, 208, 0.2) 100%);
    mix-blend-mode: screen;
  }

  .cc-blob--shimmer .cc-blob-inner--red {
    opacity: 0;
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.4) 0%, transparent 60%),
      conic-gradient(rgba(253, 181, 181, 0.2) 0%, rgba(252, 129, 129, 0.2) 50%, rgba(253, 181, 181, 0.2) 100%);
    mix-blend-mode: screen;
  }

  [data-mood="green"] .cc-blob--shimmer .cc-blob-inner--default { opacity: 0; }
  [data-mood="green"] .cc-blob--shimmer .cc-blob-inner--green   { opacity: 0.8; }
  [data-mood="green"] .cc-blob--shimmer .cc-blob-inner--red     { opacity: 0; }

  [data-mood="red"] .cc-blob--shimmer .cc-blob-inner--default { opacity: 0; }
  [data-mood="red"] .cc-blob--shimmer .cc-blob-inner--green   { opacity: 0; }
  [data-mood="red"] .cc-blob--shimmer .cc-blob-inner--red     { opacity: 0.8; }

  /* ============================================
     Layer 3 — outer aura
     ============================================ */
  .cc-blob--aura {
    inset: -22%;
    filter: blur(clamp(40px, 10vw, 65px));
  }

  .cc-blob--aura .cc-blob-inner--default {
    opacity: 0.5;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
  }

  .cc-blob--aura .cc-blob-inner--green {
    opacity: 0;
    background: radial-gradient(circle, rgba(52, 211, 153, 0.2) 0%, transparent 70%);
  }

  .cc-blob--aura .cc-blob-inner--red {
    opacity: 0;
    background: radial-gradient(circle, rgba(231, 92, 92, 0.2) 0%, transparent 70%);
  }

  [data-mood="green"] .cc-blob--aura .cc-blob-inner--default { opacity: 0; }
  [data-mood="green"] .cc-blob--aura .cc-blob-inner--green   { opacity: 0.5; }
  [data-mood="green"] .cc-blob--aura .cc-blob-inner--red     { opacity: 0; }

  [data-mood="red"] .cc-blob--aura .cc-blob-inner--default { opacity: 0; }
  [data-mood="red"] .cc-blob--aura .cc-blob-inner--green   { opacity: 0; }
  [data-mood="red"] .cc-blob--aura .cc-blob-inner--red     { opacity: 0.5; }

  /* ============================================
     Face SVG — follows cursor direction
     ============================================ */
  .cta-char-face {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 55%;
    height: 55%;
    z-index: 10;
    filter: drop-shadow(0 0 8px rgba(255,255,255,0.8));
    animation: char-bob 6s ease-in-out infinite;
    pointer-events: none;
    /* Face shifts with cursor: horizontal + subtle vertical tilt */
    transition: transform 0.3s ease-out;
    transform: translateX(calc(var(--look-x, 0) * 10%)) translateY(calc(var(--look-y, 0) * 6%));
  }

  @keyframes char-bob {
    0%, 100% {
      transform: translateX(calc(var(--look-x, 0) * 10%)) translateY(calc(var(--look-y, 0) * 6% + 0px));
    }
    33% {
      transform: translateX(calc(var(--look-x, 0) * 10%)) translateY(calc(var(--look-y, 0) * 6% - 10px));
    }
    66% {
      transform: translateX(calc(var(--look-x, 0) * 10%)) translateY(calc(var(--look-y, 0) * 6% + 5px));
    }
  }

  /* Mouth variants */
  .char-mouth-set {
    transition: opacity 0.5s ease;
  }

  .char-mouth-set--default { opacity: 1; }
  .char-mouth-set--green   { opacity: 0; }
  .char-mouth-set--red     { opacity: 0; }

  [data-mood="green"] .char-mouth-set--default { opacity: 0; }
  [data-mood="green"] .char-mouth-set--green   { opacity: 1; }
  [data-mood="green"] .char-mouth-set--red     { opacity: 0; }

  [data-mood="red"] .char-mouth-set--default { opacity: 0; }
  [data-mood="red"] .char-mouth-set--green   { opacity: 0; }
  [data-mood="red"] .char-mouth-set--red     { opacity: 1; }
</style>
