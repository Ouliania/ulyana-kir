---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';

/** Correct win order top→bottom; tray order shuffled in `cta-site-toy.ts` */
const tiles = [
  { id: 'hero', tone: 'blue' },
  { id: 'path', tone: 'violet' },
  { id: 'benefits', tone: 'lime' },
  { id: 'trust', tone: 'yellow' },
  { id: 'objections', tone: 'shell' },
  { id: 'finalCta', tone: 'blue' },
  { id: 'faq', tone: 'muted' },
] as const;

const labels: Record<(typeof tiles)[number]['id'], string> = {
  hero: t(locale, 'ctaToyHero'),
  path: t(locale, 'ctaToyPath'),
  benefits: t(locale, 'ctaToyBenefits'),
  trust: t(locale, 'ctaToyTrust'),
  objections: t(locale, 'ctaToyObjections'),
  finalCta: t(locale, 'ctaToyFinalCta'),
  faq: t(locale, 'ctaToyFaq'),
};
---

<div class="cta-toy" data-cta-toy aria-label={t(locale, 'ctaToyAria')}>
  <div class="cta-toy-field" data-cta-field>
    <div class="cta-toy-menu" aria-hidden="true">
      <span class="cta-toy-menu-mark"></span>
      <span class="cta-toy-menu-links">
        <span></span>
        <span></span>
      </span>
    </div>

    <div class="cta-toy-stack" data-cta-stack aria-live="polite"></div>

    <p class="cta-toy-hint" data-cta-hint>{t(locale, 'ctaToyHint')}</p>
  </div>

  <div class="cta-toy-tray" data-cta-tray>
    {
      tiles.map((tile) => (
        <button
          type="button"
          class:list={['cta-toy-tile', `cta-toy-tile--${tile.tone}`]}
          data-cta-tile
          data-tile-id={tile.id}
          draggable="false"
        >
          {labels[tile.id]}
        </button>
      ))
    }
  </div>
</div>

<style>
  .cta-toy {
    --cta-tile-h: 2.75rem;
    --cta-stack-gap: 0.4rem;
    /* Room for all 7 kit tiles stacked — same height empty or full */
    --cta-stack-min: calc(7 * var(--cta-tile-h) + 6 * var(--cta-stack-gap));
    width: 100%;
    max-width: min(100%, 34rem);
    margin-inline: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-media);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cta-toy-field {
    position: relative;
    flex: 0 0 auto;
    background: color-mix(in srgb, var(--color-shell) 35%, #fff);
    padding: 0.85rem 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    overflow: hidden;
  }

  .cta-toy-menu {
    flex-shrink: 0;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-default);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-text-primary) 4%, transparent);
  }

  .cta-toy-menu-mark {
    width: 2rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-blue);
  }

  .cta-toy-menu-links {
    display: flex;
    gap: 0.4rem;
  }

  .cta-toy-menu-links span {
    width: 1rem;
    height: 0.2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
  }

  .cta-toy-stack {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--cta-stack-gap);
    min-height: var(--cta-stack-min);
    flex: 0 0 auto;
  }

  .cta-toy-stack :global(.cta-toy-tile) {
    width: 100% !important;
    max-width: 100%;
  }

  .cta-toy-hint {
    position: absolute;
    inset-inline: 1.5rem;
    top: 58%;
    transform: translateY(-50%);
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .cta-toy.is-filled .cta-toy-hint,
  .cta-toy.is-won .cta-toy-hint {
    opacity: 0;
  }

  .cta-toy-tray {
    /* Natural chip widths (text-driven); 2 rows via wide plaque, ⊥ equal columns */
    --cta-tray-gap: 0.5rem;
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    gap: var(--cta-tray-gap);
    width: 100%;
    padding: 1rem 0.9rem 1.05rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .cta-toy-tile {
    cursor: grab;
    touch-action: none;
    user-select: none;
    appearance: none;
    border: 1px solid transparent;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;
    width: fit-content;
    max-width: 100%;
    min-height: 2.75rem; /* ≥44px touch target */
    height: auto;
    padding: 0.55rem 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    transition:
      box-shadow 0.18s ease,
      transform 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .cta-toy-tile:active {
    cursor: grabbing;
    transform: scale(0.98);
  }

  .cta-toy-tile:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .cta-toy-tray .cta-toy-tile:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px color-mix(in srgb, var(--color-text-primary) 8%, transparent);
    }
  }

  .cta-toy-tile--lime {
    background: var(--color-lime);
    color: #0c972f;
    border-color: color-mix(in srgb, #0c972f 18%, transparent);
  }
  .cta-toy-tile--blue {
    background: var(--color-blue-tint);
    color: var(--color-blue);
    border-color: color-mix(in srgb, var(--color-blue) 18%, transparent);
  }
  .cta-toy-tile--violet {
    background: color-mix(in srgb, var(--color-violet) 12%, #fff);
    color: var(--color-violet);
    border-color: color-mix(in srgb, var(--color-violet) 20%, transparent);
  }
  .cta-toy-tile--yellow {
    background: var(--color-yellow);
    color: #857200;
    border-color: color-mix(in srgb, #857200 18%, transparent);
  }
  .cta-toy-tile--shell {
    background: var(--color-shell);
    color: var(--color-text-secondary);
    border-color: color-mix(in srgb, var(--color-text-primary) 10%, transparent);
  }
  .cta-toy-tile--muted {
    background: color-mix(in srgb, var(--color-border) 55%, #fff);
    color: var(--color-text-muted);
    border-color: color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .cta-toy-tile.is-dragging {
    opacity: 0.35;
  }

  .cta-toy-tile.is-ghost {
    position: fixed;
    z-index: 80;
    margin: 0;
    pointer-events: none;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--color-text-primary) 12%, transparent);
    transform: scale(1.04);
  }

  .cta-toy-field.is-drop-target {
    outline: 1px dashed color-mix(in srgb, var(--color-blue) 35%, transparent);
    outline-offset: -6px;
  }

  /* In-stack feedback: color + left bar (not color-only) */
  .cta-toy-stack :global(.cta-toy-tile.is-correct) {
    background: var(--color-lime) !important;
    color: #0c972f !important;
    border-color: color-mix(in srgb, #0c972f 28%, transparent) !important;
    box-shadow: inset 3px 0 0 #0c972f;
  }

  .cta-toy-stack :global(.cta-toy-tile.is-wrong) {
    background: color-mix(in srgb, #e85d4c 16%, #fff) !important;
    color: #c23b2a !important;
    border-color: color-mix(in srgb, #c23b2a 28%, transparent) !important;
    box-shadow: inset 3px 0 0 #c23b2a;
  }

  /* Win: still separate plaques, one shared tint — ⊥ white underlay merge */
  .cta-toy.is-won .cta-toy-stack {
    pointer-events: none;
  }

  .cta-toy.is-won .cta-toy-stack :global(.cta-toy-tile) {
    background: var(--color-blue-tint) !important;
    color: var(--color-blue) !important;
    border-color: color-mix(in srgb, var(--color-blue) 22%, transparent) !important;
    cursor: default;
  }

  @media (min-width: 900px) {
    .cta-toy {
      margin-inline: 0 0 auto;
    }
  }
</style>
