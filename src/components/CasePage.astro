---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageShell from './PageShell.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import InteractiveHoverButton from './InteractiveHoverButton.astro';
import KineticText from './KineticText.astro';
import { t, type Locale } from '../i18n/ui';
import { caseLocalized, type CaseStudy } from '../data/cases';

interface Props {
  locale: Locale;
  item: CaseStudy;
}

const { locale, item } = Astro.props;
const copy = caseLocalized(item, locale);
const homeCases = locale === 'ru' ? '/ru/#cases' : '/#cases';
const casesIndex = locale === 'ru' ? '/ru/cases/' : '/cases/';
const serviceTitle = copy.tag;
---

<Layout
  title={`${serviceTitle} — Case | Ulyana Kirp`}
  description={copy.problem}
  lang={locale}
>
  <Header locale={locale} />

  <PageShell>
  <main class="case-page">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, 'cases'), href: casesIndex },
        { label: item.projectName },
      ]}
    />
    <section class="case-first">
      <div class="container case-stack">
        <div class="case-grid" data-animate="hero">
          <div class="col">
            <KineticText as="h1" class="service-name" text={serviceTitle} />
            <p class="project-caption">
              <span class="case-for">{t(locale, 'caseFor')}</span>{' '}
              {
                item.url ? (
                  <a
                    class="project-link"
                    href={item.url}
                    target={item.url.startsWith('http') ? '_blank' : undefined}
                    rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {item.projectName}
                  </a>
                ) : (
                  <span class="project-link muted">{item.projectName}</span>
                )
              }
            </p>
            <p class="project-expanded">{copy.project}</p>
            <p class="roles">{item.role.join(' · ')}</p>
            {
              item.stack && (
                <p class="stack-line">
                  <span class="stack-label">{t(locale, 'stack')}</span>
                  {': '}
                  <span class="stack-value">{item.stack[locale]}</span>
                </p>
              )
            }
          </div>
          <div class="col">
            <p class="label">{t(locale, 'problemWas')}</p>
            <p class="body-text">{copy.problem}</p>
          </div>
          <div class="col">
            <p class="label">{t(locale, 'solutionDone')}</p>
            <ul class="solution-list">
              {copy.solution.map((step) => (
                <li>{step}</li>
              ))}
            </ul>
            {
              copy.metrics.length > 0 && (
                <div class="result-block">
                  <p class="label">{t(locale, 'result')}</p>
                  <ul class="metric-list">
                    {copy.metrics.map((m) => (
                      <li class="metric-item">
                        <span class="metric-value">{m.value}</span>
                        <span class="metric-label">{m.label}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
            {
              copy.metrics.length === 0 && copy.result.length > 0 && (
                <div class="result-block">
                  <p class="label">{t(locale, 'result')}</p>
                  <ul class="result-list">
                    {copy.result.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        </div>

        <div
          class:list={['media-stage', item.mediaAspect === 'portrait' && 'media-stage--portrait']}
          data-animate="hero"
          data-media-aspect={item.mediaAspect ?? 'landscape'}
        >
          {
            item.video ? (
              <video
                class:list={['media-video', item.mediaAspect === 'portrait' && 'media-video--portrait']}
                src={item.video}
                poster={item.poster}
                muted
                playsinline
                loop
                autoplay
                controls
                preload="metadata"
              />
            ) : (
              <div class:list={['media-placeholder', item.mediaAspect === 'portrait' && 'media-placeholder--portrait']}>
                <p>{t(locale, 'videoSoon')}</p>
                {
                  item.url?.startsWith('http') && (
                    <a class="btn btn-primary" href={item.url} target="_blank" rel="noopener noreferrer">
                      {t(locale, 'openLive')}
                    </a>
                  )
                }
                {
                  item.url?.startsWith('/') && (
                    <a class="btn btn-primary" href={item.url}>
                      {t(locale, 'openDemo')}
                    </a>
                  )
                }
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="case-next">
      <div class="container next-inner" data-animate="reveal">
        <a href={homeCases} class="back-link">{t(locale, 'backCases')}</a>
        {
          item.url?.startsWith('http') && (
            <InteractiveHoverButton
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              label={t(locale, 'openLive')}
            />
          )
        }
      </div>
    </section>
  </main>

  <Footer locale={locale} />
  </PageShell>
</Layout>

<style>
  .case-page {
    background: transparent;
  }

  .case-first {
    padding-block: 1.5rem var(--section-gap);
  }

  .case-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .case-grid {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .case-grid {
      grid-template-columns: 1.1fr 1.15fr 1.15fr;
      gap: 2.25rem;
      align-items: start;
    }
  }

  .service-name {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-block-end: 0.5rem;
  }

  .project-caption {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-block-end: 0.5rem;
  }

  .case-for {
    color: var(--color-text-muted);
  }

  .project-link {
    color: var(--color-text-secondary);
  }

  .project-link.muted {
    color: var(--color-text-muted);
  }

  .project-expanded {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    margin-block-end: 0.55rem;
  }

  .roles {
    font-size: 0.85rem;
    color: var(--color-teal, var(--color-blue));
    margin-block-end: 0.45rem;
  }

  .stack-line {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-block-end: 0.45rem;
  }

  .body-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.2;
  }

  .solution-list {
    margin: 0;
    padding-inline-start: 1.1rem;
    list-style: disc;
    display: grid;
    gap: 0.45rem;
  }

  .solution-list li {
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-text-secondary);
  }

  .result-block {
    margin-block-start: 1.15rem;
  }

  .result-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .result-list li {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  .metric-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-value {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-blue);
    line-height: 1;
  }

  .metric-label {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.2;
  }

  .media-stage {
    width: 100%;
  }

  .media-stage--portrait {
    display: flex;
    justify-content: center;
  }

  .media-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    border-radius: var(--radius-media, 8px);
    background: transparent;
  }

  .media-video--portrait {
    width: min(20rem, 100%);
    aspect-ratio: 9 / 19.5;
    object-fit: cover;
    background: #0f1218;
  }

  .media-placeholder {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    gap: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-media, 8px);
    color: var(--color-text-muted);
  }

  .media-placeholder--portrait {
    width: min(20rem, 100%);
    aspect-ratio: 9 / 19.5;
    margin-inline: auto;
  }

  .case-next {
    padding-block: 0 var(--section-gap);
  }

  .next-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .back-link {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
