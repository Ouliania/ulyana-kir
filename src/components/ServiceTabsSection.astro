</style>

<script>
  let stReady = false;

  const initST = () => {
    if (stReady) return;
    const rails = document.querySelectorAll<HTMLElement>('.st-rail');
    const tabs = document.querySelectorAll<HTMLElement>('.st-tab');
    const cards = document.querySelectorAll<HTMLElement>('.st-card');
    const vizs = document.querySelectorAll<HTMLElement>('.st-viz');

    if (!tabs.length || !cards.length) return;
    stReady = true;

    const isDesktop = () => window.innerWidth >= 768;
    let activeIdx = -1;

    const setActive = (idx: number) => {
      if (idx < 0 || idx >= cards.length) return;
      if (idx === activeIdx) return;
      activeIdx = idx;
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      cards.forEach((c, i) => c.classList.toggle('active', i === idx));
      vizs.forEach((v, i) => v.classList.toggle('active', i === idx));
    };

    // Always paint first tab immediately (HTML may already have .active)
    setActive(0);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        setActive(i);
        if (isDesktop() && rails[i]) {
          rails[i].scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    if (isDesktop() && rails.length) {
      const onScroll = () => {
        const vMid = window.innerHeight / 2;
        let bestIdx = 0;
        let bestDist = Infinity;
        rails.forEach((rail, i) => {
          const rect = rail.getBoundingClientRect();
          const mid = rect.top + rect.height / 2;
          const dist = Math.abs(mid - vMid);
          if (dist < bestDist) {
            bestDist = dist;
            bestIdx = i;
          }
        });
        setActive(bestIdx);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    document.querySelectorAll<HTMLFormElement>('.st-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = form.querySelector<HTMLInputElement>('.st-input');
        const status = form.querySelector<HTMLElement>('.st-status');
        const modal = form.closest<HTMLDialogElement>('[data-st-modal]');
        if (!input) return;
        const contact = input.value.trim();
        if (!contact) return;

        const methodEl = form.querySelector<HTMLInputElement>('input[name="method"]:checked');
        const method = methodEl?.value || 'telegram';
        const service = modal?.dataset.service || '';
        const sending = modal?.dataset.msgSending || 'Sending...';
        const thanks = modal?.dataset.msgThanks || "Thanks! I'll reach out shortly";
        const errMsg = modal?.dataset.msgError || 'Error. Message me on Telegram: @UlyanaKir';

        if (status) {
          status.textContent = sending;
          status.className = 'st-status';
        }

        try {
          const BOT_TOKEN = (window as any).__TELEGRAM_BOT_TOKEN__;
          const CHAT_ID = (window as any).__TELEGRAM_CHAT_ID__;
          if (BOT_TOKEN && CHAT_ID) {
            const msg = `New lead from ulyanaweb.ru (services)\nService: ${service}\nContact: ${contact}\nMethod: ${method}`;
            await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ chat_id: CHAT_ID, text: msg }),
            });
          }
          if (status) {
            status.textContent = thanks;
            status.className = 'st-status success';
          }
          form.reset();
        } catch (_err) {
          if (status) {
            status.textContent = errMsg;
            status.className = 'st-status error';
          }
        }
      });
    });

    const modal = document.querySelector<HTMLDialogElement>('[data-st-modal]');
    const modalTitle = modal?.querySelector<HTMLElement>('[data-st-modal-title]');
    const defaultTitle = modalTitle?.textContent || '';

    document.querySelectorAll<HTMLButtonElement>('[data-st-open-form]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!modal) return;
        const service = btn.dataset.service || '';
        modal.dataset.service = service;
        if (modalTitle) {
          modalTitle.textContent = service || defaultTitle;
        }
        const status = modal.querySelector<HTMLElement>('.st-status');
        if (status) {
          status.textContent = '';
          status.className = 'st-status';
        }
        modal.showModal();
      });
    });

    modal?.querySelectorAll('[data-st-modal-close]').forEach((btn) => {
      btn.addEventListener('click', () => modal.close());
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  };

  document.addEventListener('DOMContentLoaded', initST);
  document.addEventListener('astro:after-swap', () => {
    stReady = false;
    initST();
  });
  if (document.readyState !== 'loading') initST();
</script>
