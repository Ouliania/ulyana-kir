---
import { t, type Locale } from '../i18n/ui';

interface Props {
  ctaType?: 'audit' | 'copywriting' | 'redesign' | 'general';
  ctaTitle?: string;
  ctaDesc?: string;
  ctaButton?: string;
  locale?: Locale;
}

const {
  ctaType = 'general',
  ctaTitle: overrideTitle,
  ctaDesc: overrideDesc,
  ctaButton: overrideButton,
  locale = 'ru',
} = Astro.props;

const ctaKeys = {
  audit: {
    title: 'blogCtaAuditTitle',
    desc: 'blogCtaAuditDesc',
    button: 'blogCtaAuditButton',
  },
  copywriting: {
    title: 'blogCtaCopyTitle',
    desc: 'blogCtaCopyDesc',
    button: 'blogCtaCopyButton',
  },
  redesign: {
    title: 'blogCtaRedesignTitle',
    desc: 'blogCtaRedesignDesc',
    button: 'blogCtaRedesignButton',
  },
  general: {
    title: 'blogCtaGeneralTitle',
    desc: 'blogCtaGeneralDesc',
    button: 'blogCtaGeneralButton',
  },
}[ctaType];

const title = overrideTitle || t(locale, ctaKeys.title as any);
const desc = overrideDesc || t(locale, ctaKeys.desc as any);
const buttonText = overrideButton || t(locale, ctaKeys.button as any);

const badgeText = locale === 'ru' ? 'Бесплатно • 20 минут в переписке' : 'Free • 20 min in chat';
const secondBtnText = locale === 'ru' ? 'Написать в Telegram' : 'Message on Telegram';
---

<section class="blog-cta-section">
  <div class="blog-cta-card">
    <div class="cta-header">
      <span class="cta-badge">{badgeText}</span>
    </div>
    <h3 class="cta-title">{title}</h3>
    <p class="cta-text">{desc}</p>
    <div class="cta-actions">
      <button
        type="button"
        class="btn btn-primary cta-btn"
        data-contact-popup
        data-contact-title={title}
        data-contact-subtitle={desc}
        data-contact-cta-type={ctaType}
      >
        {buttonText}
      </button>
      <a href="https://t.me/UlyanaKir" target="_blank" rel="noopener noreferrer" class="btn btn-secondary cta-btn">
        {secondBtnText}
      </a>
    </div>
  </div>
</section>

<style>
  .blog-cta-section {
    margin-block-start: 4.5rem;
    margin-block-end: 2rem;
    border-top: 1px solid var(--color-border);
    padding-block-start: 4.5rem;
    max-inline-size: 100%;
    width: 100%;
  }

  .blog-cta-card {
    background: var(--color-blue-tint);
    border: 1px solid var(--color-blue-soft);
    border-radius: var(--radius-card);
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    width: 100%;
  }

  @media (max-width: 640px) {
    .blog-cta-card {
      padding: 2rem 1.5rem;
    }
  }

  .cta-badge {
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    background: var(--color-blue);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-default);
    display: inline-block;
    letter-spacing: 0.03em;
  }

  .cta-title {
    font-size: 1.5rem;
    margin: 0;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .cta-text {
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
    max-inline-size: 680px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block-start: 0.5rem;
  }

  .cta-btn {
    text-transform: uppercase;
    font-size: var(--control-font-size);
    padding: var(--control-pad-block) var(--control-pad-inline);
    line-height: var(--control-line-height);
    text-decoration: none;
    cursor: pointer;
  }
</style>
