---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';
const quote = t(locale, 'interludeQuote');
const attr = t(locale, 'interludeAttr');
const words = quote.split(/\s+/).filter(Boolean);
---

<section id="interlude" class="interlude" data-interlude-root aria-label={locale === 'ru' ? 'Интерлюдия' : 'Interlude'}>
  <div class="interlude-stage">
    <div class="interlude-frame">
      <div class="interlude-bg" aria-hidden="true">
        <div class="interlude-waves-container" data-interlude="bg">
          <svg class="interlude-waves" viewBox="0 0 1080 600" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path class="wave wave-1" d="M0,285 C360,170 720,400 1080,285 C1440,170 1800,400 2160,285 L2160,600 L0,600 Z"></path>
            <path class="wave wave-2" d="M0,350 C360,240 720,460 1080,350 C1440,240 1800,460 2160,350 L2160,600 L0,600 Z"></path>
            <path class="wave wave-3" d="M0,415 C360,315 720,515 1080,415 C1440,315 1800,515 2160,415 L2160,600 L0,600 Z"></path>
            <path class="wave wave-4" d="M0,220 C360,90 720,350 1080,220 C1440,90 1800,350 2160,220 L2160,600 L0,600 Z"></path>
          </svg>
        </div>
        <div class="interlude-vignette" data-interlude="vignette"></div>
        <div class="interlude-solid-bg" data-interlude="solid-bg"></div>
      </div>

      <div class="interlude-copy">
        <blockquote class="interlude-quote">
          <p class="interlude-line">
            {
              words.map((word, wordIdx) => (
                <>
                  <span class="interlude-word">{word.split('').map((char) => <span class="interlude-char" data-interlude="char">{char}</span>)}</span>
                  {wordIdx < words.length - 1 && ' '}
                </>
              ))
            }
          </p>
        </blockquote>
      </div>
      <cite class="interlude-attr" data-interlude="attr">{attr}</cite>
    </div>
  </div>
</section>

<style>
  .interlude {
    position: relative;
    z-index: 2;
    width: 100%;
    background: transparent;
    color: #ffffff;
    margin-top: 0;
    pointer-events: none;
  }

  .interlude-stage {
    --interlude-view: calc(100svh - var(--header-height));
    box-sizing: border-box;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 0;
    pointer-events: none;
  }

  .interlude-frame {
    position: relative;
    width: 120px;
    height: 120px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    transform: translateY(0);
    transform-origin: center center;
    pointer-events: auto;

    /* Palette cycling colors */
    --wave-col-1: var(--color-blue);
    --wave-col-2: var(--color-violet);
    --wave-col-3: #eab308; /* Vibrant Yellow/Amber */

    --bg-col-1: var(--color-blue-tint);
    --bg-col-2: #c8c4ee;
    --bg-col-3: var(--color-yellow);

    animation: interludeBgCycle 20s infinite linear;
  }

  .interlude-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: inherit;
  }

  .interlude-waves-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    will-change: transform;
    transform-origin: center center;
  }

  .interlude-waves {
    position: absolute;
    bottom: -15%;
    left: 0;
    width: 200%;
    height: 100%;
    display: block;
  }

  .wave {
    animation-name: waveFillCycle;
    animation-duration: 20s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    fill: var(--wave-col-1);
    opacity: 0.4;
    transform-origin: center bottom;
    transform-box: fill-box;
    will-change: transform, fill;
  }

  .wave-1 {
    --ty: 0%;
    animation-name: waveMoveReverse, waveFillCycle;
    animation-duration: 9s, 20s;
    animation-timing-function: ease-in-out, linear;
    animation-iteration-count: infinite, infinite;
  }

  .wave-2 {
    --ty: 2.5%;
    animation-name: waveMove, waveFillCycle;
    animation-duration: 12s, 20s;
    animation-timing-function: ease-in-out, linear;
    animation-iteration-count: infinite, infinite;
  }

  .wave-3 {
    --ty: 5%;
    animation-name: waveMoveReverse, waveFillCycle;
    animation-duration: 15s, 20s;
    animation-timing-function: ease-in-out, linear;
    animation-iteration-count: infinite, infinite;
  }

  .wave-4 {
    --ty: 7.5%;
    animation-name: waveMove, waveFillCycle;
    animation-duration: 10s, 20s;
    animation-timing-function: ease-in-out, linear;
    animation-iteration-count: infinite, infinite;
  }

  @keyframes interludeBgCycle {
    0%, 15%, 100% {
      background-color: var(--bg-col-1);
    }
    20%, 40%, 70%, 90% {
      background-color: var(--bg-col-2);
    }
    45%, 65% {
      background-color: var(--bg-col-3);
    }
  }

  @keyframes waveFillCycle {
    0%, 15%, 100% {
      fill: var(--wave-col-1);
    }
    20%, 40%, 70%, 90% {
      fill: var(--wave-col-2);
    }
    45%, 65% {
      fill: var(--wave-col-3);
    }
  }

  @keyframes waveMoveReverse {
    0% {
      transform: translate3d(-50%, var(--ty), 0);
    }
    50% {
      transform: translate3d(0, var(--ty), 0);
    }
    100% {
      transform: translate3d(-50%, var(--ty), 0);
    }
  }

  @keyframes waveMove {
    0% {
      transform: translate3d(0, var(--ty), 0);
    }
    50% {
      transform: translate3d(-50%, var(--ty), 0);
    }
    100% {
      transform: translate3d(0, var(--ty), 0);
    }
  }

  .interlude-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, rgba(255, 255, 255, 0.2) 100%);
    pointer-events: none;
    z-index: 1;
    border-radius: inherit;
  }

  .interlude-solid-bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-blue);
    z-index: 2;
    pointer-events: none;
    will-change: opacity;
    border-radius: inherit;
  }

  .interlude-copy {
    position: relative;
    z-index: 3;
    width: min(100%, 48rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    color: var(--color-text-primary);
    opacity: 0;
  }

  .interlude-quote {
    margin: 0;
  }

  .interlude-line {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 3.6vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-text-primary);
  }

  .interlude-word {
    display: inline-block;
    white-space: nowrap;
  }

  .interlude-char {
    display: inline-block;
    color: var(--color-text-primary);
    opacity: 0;
    filter: blur(10px);
    transform: translateY(20px);
    will-change: transform, opacity, filter;
  }

  .interlude-attr {
    position: absolute;
    z-index: 3;
    right: clamp(1.1rem, 2.4vw, 1.75rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .interlude {
      margin-top: 0 !important;
      background: var(--color-surface) !important;
      pointer-events: auto !important;
    }

    .interlude-stage {
      min-height: 0;
      padding-block: var(--section-gap);
      pointer-events: auto !important;
    }

    .interlude-frame {
      width: 100% !important;
      height: auto !important;
      max-height: none !important;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-media) !important;
      transform: none !important;
    }

    .interlude-bg {
      transform: none !important;
      scale: 1 !important;
    }

    .interlude-copy {
      opacity: 1 !important;
    }

    .interlude-solid-bg {
      opacity: 0 !important;
    }

    .interlude-waves-container,
    .interlude-char,
    .interlude-line,
    .interlude-attr {
      transform: none !important;
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>
