---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';
const quote = t(locale, 'interludeQuote');
const attr = t(locale, 'interludeAttr');
const words = quote.split(/\s+/).filter(Boolean);
---

<section id="interlude" class="interlude" data-interlude-root aria-label={locale === 'ru' ? 'Интерлюдия' : 'Interlude'}>
  <div class="interlude-stage">
    <div class="interlude-frame">
      <div class="interlude-bg" aria-hidden="true">
        <div class="interlude-bg-layer" data-interlude="bg">
          <img
            class="interlude-img"
            src="/images/simulator_backdrop.webp"
            alt=""
            width="1920"
            height="1080"
            decoding="async"
            fetchpriority="low"
          />
        </div>
        <div class="interlude-vignette" data-interlude="vignette"></div>
        <div class="interlude-grid" data-interlude="grid"></div>
      </div>

      <div class="interlude-copy">
        <blockquote class="interlude-quote">
          <p class="interlude-line">
            {
              words.map((word) => (
                <span class="interlude-word" data-interlude="word">
                  {word}
                </span>
              ))
            }
          </p>
        </blockquote>
      </div>
      <cite class="interlude-attr" data-interlude="attr">{attr}</cite>
    </div>
  </div>
</section>

<style>
  .interlude {
    position: relative;
    z-index: 2;
    width: 100%;
    background: var(--color-surface);
    color: #ffffff;
  }

  .interlude-stage {
    --interlude-view: calc(100svh - var(--header-height));
    box-sizing: border-box;
    min-height: var(--interlude-view);
    display: grid;
    place-items: center;
    padding: var(--section-gap) var(--content-inline);
  }

  .interlude-frame {
    position: relative;
    width: 100%;
    height: calc(var(--interlude-view) - (2 * var(--section-gap)));
    max-height: calc(var(--interlude-view) - (2 * var(--section-gap)));
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: #0a1630;
  }

  .interlude-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: inherit;
  }

  .interlude-bg-layer {
    position: absolute;
    inset: -10% 0 0 0;
    will-change: transform;
    transform-origin: center center;
  }

  .interlude-img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.85);
    will-change: transform;
  }

  .interlude-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(10, 22, 48, 0.4) 100%);
    pointer-events: none;
    z-index: 1;
    border-radius: inherit;
  }

  .interlude-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 80px 80px;
    pointer-events: none;
    z-index: 2;
    border-radius: inherit;
  }

  .interlude-copy {
    position: relative;
    z-index: 3;
    width: min(100%, 48rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    color: #ffffff;
  }

  .interlude-quote {
    margin: 0;
  }

  .interlude-line {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 3.6vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: #ffffff;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
  }

  .interlude-word {
    display: inline-block;
    margin-inline: 0.18em;
    color: #ffffff;
    opacity: 0;
    filter: blur(8px);
    transform: scale(0.6);
    will-change: transform, opacity, filter;
  }

  .interlude-word:first-child {
    margin-inline-start: 0;
  }

  .interlude-word:last-child {
    margin-inline-end: 0;
  }

  .interlude-attr {
    position: absolute;
    z-index: 3;
    right: clamp(1.1rem, 2.4vw, 1.75rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .interlude-stage {
      min-height: 0;
    }

    .interlude-frame {
      height: auto;
      max-height: none;
      aspect-ratio: 16 / 9;
    }

    .interlude-bg-layer,
    .interlude-word,
    .interlude-line,
    .interlude-grid,
    .interlude-attr {
      transform: none !important;
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>
