---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { caseLocalized, type CaseStudy } from '../data/cases';

interface Props {
  locale: Locale;
  cases: CaseStudy[];
  caseBase: string;
}

const { locale, cases, caseBase } = Astro.props;
const n = cases.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
/** Case write-ups deferred — hide «more about the case» until pages ready */
const showCaseDeepLink = false;

/** Display host only — no path/query (progolos.pro/vladivostok → progolos.pro) */
function siteHost(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}

/** Same stroke icons as services bullets — cycled per solution step */
const solutionIcons: string[][] = [
  ['M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z', 'M21 21l-4.35-4.35'],
  [
    'M5 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
    'M19 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
    'M7 16l2.5-1.5c2-1.2 5-1.2 7 0L19 16',
  ],
  ['M12 2 2 7l10 5 10-5-10-5Z', 'M2 17l10 5 10-5', 'M2 12l10 5 10-5'],
  [
    'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.1 2.1-2.2-2.2 2.1-2.1Z',
  ],
];
---

<section
  class="cs"
  data-cases-stage
  data-cs-draft="982a80e2"
  style={`--cs-n: ${n}`}
  aria-label={t(locale, 'cases')}
>
  <div class="cs-pin">
    <div class="cs-stage">
      {/* LEFT — chrome + media + tag + CTA */}
      <div class="cs-visual">
        <div class="cs-chrome">
          <div class="cs-progress" role="tablist" aria-label={t(locale, 'cases')}>
            {
              cases.map((item, i) => (
                <button
                  type="button"
                  class:list={['cs-dot', i === 0 && 'is-active']}
                  data-cs-dot={i}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={`${pad(i)} · ${caseLocalized(item, locale).tag}`}
                />
              ))
            }
          </div>
          <p class="cs-index" data-cs-index aria-hidden="true">
            <span data-cs-index-cur>01</span>
            <span class="cs-index-sep">/</span>
            <span>{pad(n - 1)}</span>
          </p>
        </div>

        <div class="cs-stack cs-stack--media">
          {
            cases.map((item, i) => (
              <div
                class:list={['cs-layer', 'cs-layer--media', i === 0 && 'is-active']}
                data-cs-i={i}
              >
                <div class="cs-floating-media">
                  {item.video ? (
                    <video
                      class="cs-video"
                      src={item.video}
                      poster={item.poster}
                      muted
                      playsinline
                      loop
                      preload={i === 0 ? 'metadata' : 'none'}
                      data-cs-video
                    />
                  ) : (
                    <div class="cs-video-ph">{t(locale, 'videoSoon')}</div>
                  )}
                </div>
              </div>
            ))
          }
        </div>

        <div class="cs-stack cs-stack--cta">
          {
            cases.map((item, i) => {
              const href = `${caseBase}${item.slug}/`;
              const copy = caseLocalized(item, locale);
              return (
                <div class:list={['cs-layer', 'cs-cta', i === 0 && 'is-active']} data-cs-i={i}>
                  {copy.metrics.length > 0 && (
                    <div class="cs-proof-block">
                      <p class="cs-result-label">{t(locale, 'result')}</p>
                      <div class="cs-proof">
                        {copy.metrics.map((m) => (
                          <div class="cs-proof-item">
                            <p class="cs-proof-value">{m.value}</p>
                            <p class="cs-proof-desc">{m.label}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {copy.metrics.length === 0 && copy.result.length > 0 && (
                    <div class="cs-result-prose">
                      <p class="cs-result-label">{t(locale, 'result')}</p>
                      {copy.result.map((line) => (
                        <p class:list={['cs-text', 'cs-text--result']}>{line}</p>
                      ))}
                    </div>
                  )}

                  {showCaseDeepLink && (
                    <div class="cs-cta-row">
                      <a href={href} class="btn btn-primary">
                        {t(locale, 'caseExplore')}
                        <span class="cs-btn-arrow" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>

      {/* RIGHT — structured copy */}
      <aside class="cs-copy cs-stack cs-stack--copy">
        {
          cases.map((item, i) => {
            const copy = caseLocalized(item, locale);
            return (
              <div class:list={['cs-layer', 'cs-copy-panel', i === 0 && 'is-active']} data-cs-i={i}>
                <div class="cs-project-block">
                  <div class="cs-meta">
                    <p class="cs-service">{copy.tag}</p>
                    <div class="cs-chips">
                      {item.role.map((role) => (
                        <span class="cs-chip">{role}</span>
                      ))}
                    </div>
                  </div>
                  <p class="cs-project">{copy.project}</p>
                  {item.url?.startsWith('http') && (
                    <a
                      href={item.url}
                      class="cs-live"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {siteHost(item.url)}
                    </a>
                  )}
                  {item.url?.startsWith('/') && (
                    <a href={item.url} class="cs-live">
                      {t(locale, 'openDemo')}
                    </a>
                  )}
                </div>

                <div class="cs-fields">
                  <div class="cs-field">
                    <p class="cs-label">{t(locale, 'theBarrier')}</p>
                    <p class="cs-text">{copy.problem}</p>
                  </div>
                  <div class="cs-field">
                    <p class="cs-label">{t(locale, 'theIntervention')}</p>
                    <ul class="cs-list">
                      {copy.solution.map((step, si) => (
                        <li class="cs-bullet">
                          <svg
                            class="cs-bullet-icon"
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            {solutionIcons[si % solutionIcons.length].map((d) => (
                              <path d={d} />
                            ))}
                          </svg>
                          <span>{step}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            );
          })
        }
      </aside>
    </div>
  </div>

  <div class="cs-rails" aria-hidden="true">
    {
      cases.map((_, i) => (
        <div class="cs-rail" data-cs-rail={i}></div>
      ))
    }
  </div>

  <div class="cs-mobile">
    {
      cases.map((item, i) => {
        const copy = caseLocalized(item, locale);
        const href = `${caseBase}${item.slug}/`;
        return (
          <article class="cs-m-card">
            <div class="cs-layer--media">
              <div class="cs-floating-media">
                {item.video && (
                  <video
                    class="cs-video"
                    src={item.video}
                    poster={item.poster}
                    muted
                    playsinline
                    loop
                    autoplay
                    preload="metadata"
                  />
                )}
              </div>
            </div>
            <div class="cs-meta">
              <p class="cs-service">{copy.tag}</p>
              <div class="cs-chips">
                {item.role.map((role) => (
                  <span class="cs-chip">{role}</span>
                ))}
              </div>
            </div>
            <p class="cs-project">{copy.project}</p>
            {item.url?.startsWith('http') && (
              <a
                href={item.url}
                class="cs-live"
                target="_blank"
                rel="noopener noreferrer"
              >
                {siteHost(item.url)}
              </a>
            )}
            {item.url?.startsWith('/') && (
              <a href={item.url} class="cs-live">
                {t(locale, 'openDemo')}
              </a>
            )}
            <p class="cs-label">{t(locale, 'theBarrier')}</p>
            <p class="cs-text">{copy.problem}</p>
            <p class="cs-label">{t(locale, 'theIntervention')}</p>
            <ul class="cs-list">
              {copy.solution.map((step, si) => (
                <li class="cs-bullet">
                  <svg
                    class="cs-bullet-icon"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {solutionIcons[si % solutionIcons.length].map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                  <span>{step}</span>
                </li>
              ))}
            </ul>
            {copy.metrics.length > 0 && (
              <div class="cs-proof-block">
                <p class="cs-result-label">{t(locale, 'result')}</p>
                <div class="cs-proof">
                  {copy.metrics.map((m) => (
                    <div class="cs-proof-item">
                      <p class="cs-proof-value">{m.value}</p>
                      <p class="cs-proof-desc">{m.label}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {copy.metrics.length === 0 && copy.result.length > 0 && (
              <>
                <p class="cs-result-label">{t(locale, 'result')}</p>
                {copy.result.map((line) => (
                  <p class:list={['cs-text', 'cs-text--result']}>{line}</p>
                ))}
              </>
            )}
            {showCaseDeepLink && (
              <div class="cs-cta">
                <a href={href} class="btn btn-primary">
                  {t(locale, 'caseExplore')}
                </a>
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</section>

<style>
  /* Superdesign 982a80e2 — Balanced Magazine Overlap — Case Stage */
  .cs {
    --cs-pad: var(--content-inline);
    --cs-draft: 982a80e2;
    position: relative;
    background: var(--color-surface);
    isolation: isolate;
  }

  .cs-pin {
    display: none;
  }

  .cs-rails {
    display: none;
  }

  .cs-chrome {
    display: none;
  }

  .cs-mobile {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding: 2rem var(--cs-pad) 3rem;
    background: var(--color-surface);
  }

  @media (min-width: 900px) {
    .cs {
      height: calc(var(--cs-n) * 100vh);
    }

    .cs-mobile {
      display: none;
    }

    .cs-pin {
      display: block;
      position: sticky;
      top: var(--header-height);
      height: auto;
      max-height: calc(100svh - var(--header-height));
      z-index: 4;
      box-sizing: border-box;
      padding: 0.5rem var(--cs-pad) 1rem;
      background: var(--color-surface);
      overflow: hidden;
    }

    .cs-rails {
      display: flex;
      flex-direction: column;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }

    .cs-rail {
      flex: 1;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    /* Magazine grid — height follows content (⊥ stretch to full viewport) */
    .cs-stage {
      --cs-align-top: 0.35rem; /* media + copy share this top */
      position: relative;
      z-index: 2;
      height: auto;
      max-inline-size: 1400px;
      margin-inline: auto;
      display: grid;
      grid-template-columns: 60vw minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
      background: var(--color-surface);
    }

    .cs-chrome {
      display: flex;
      position: relative;
      top: auto;
      right: auto;
      z-index: 30;
      align-items: center;
      gap: 1rem;
      margin-block-end: 0.75rem;
      align-self: flex-start;
    }
  }

  :global(html.is-cases-snapping) {
    scroll-snap-type: y proximity;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.is-cases-snapping) {
      scroll-snap-type: none;
    }
  }

  .cs-progress {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .cs-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: #d1d5db;
    cursor: pointer;
    transition:
      background 200ms ease,
      transform 200ms ease;
  }

  .cs-dot.is-active {
    background: var(--color-blue);
    transform: scale(1.3);
  }

  .cs-dot:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 3px;
  }

  .cs-index {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: #9ca3af;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .cs-index-sep {
    margin-inline: 0.2rem;
    opacity: 0.6;
  }

  /* —— LEFT visual —— */
  .cs-visual {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    min-height: 0;
    padding-block-start: var(--cs-align-top, 2.75rem);
  }

  .cs-stack--media {
    --cs-media-screen: 60vw;
    width: var(--cs-media-screen);
    max-width: 100%;
    margin-inline-start: 0;
    margin-block-start: 0;
    position: relative;
    z-index: 1;
  }

  .cs-layer--media {
    position: relative;
    min-height: 0;
  }

  .cs-floating-media {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-media);
    overflow: hidden;
    box-sizing: border-box;
    background: #0f1218;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.08);
  }

  .cs-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    display: block;
  }

  .cs-video-ph {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
  }

  /* —— RIGHT copy — top-aligned with media —— */
  .cs-copy {
    position: relative;
    z-index: 20;
    display: grid;
    justify-content: stretch;
    min-width: 0;
    min-height: 0;
    padding-block-start: var(--cs-align-top, 2.75rem);
    width: 100%;
  }

  .cs-copy-panel {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    width: 100%;
    max-inline-size: none;
  }

  .cs-label {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-muted);
    font-weight: 400;
    margin: 0 0 0.35rem;
  }

  .cs-result-label {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-blue);
    font-weight: 400;
    margin: 0 0 0.35rem;
  }

  .cs-project-title {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin: 0 0 0.375rem;
  }

  .cs-project-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .cs-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    width: 100%;
  }

  .cs-service {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-blue);
    margin: 0;
    min-width: 0;
  }

  .cs-project {
    font-family: var(--font-heading);
    font-size: 2rem; /* subhead */
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0;
    --cs-project-fs: 2rem;
  }

  .cs-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 0;
    flex-shrink: 0;
  }

  .cs-chip {
    padding: 0.125rem 0.5rem;
    background: transparent;
    color: var(--color-blue);
    font-size: 0.7rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.02em;
    border-radius: var(--radius-default);
    border: 1px solid var(--color-blue);
  }

  .cs-fields {
    display: grid;
    gap: 1.25rem;
    max-inline-size: none;
  }

  .cs-field {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cs-text {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .cs-text--result {
    font-weight: 500;
    color: var(--color-text-primary);
    border-inline-start: 2px solid var(--color-blue);
    padding-inline-start: 1rem;
  }

  .cs-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cs-bullet {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    padding: 0;
  }

  .cs-bullet-icon {
    color: var(--color-blue);
    flex-shrink: 0;
    margin-block-start: 0.15em;
  }

  .cs-proof-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    max-inline-size: 36rem;
  }

  .cs-proof {
    display: flex;
    gap: 1.5rem;
    padding-block: 0;
    width: 100%;
  }

  .cs-proof-item {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cs-proof-value {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 3vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-blue);
    margin: 0;
  }

  .cs-proof-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .cs-result-prose {
    padding-block: 0.15rem;
    width: 100%;
    max-inline-size: 36rem;
  }

  .cs-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin-block-start: 1.25rem;
    margin-inline-start: 2rem;
    max-inline-size: min(100%, 60vw);
  }

  .cs-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .cs-btn-arrow {
    font-size: 1em;
    line-height: 1;
  }

  .cs-live {
    font-size: 0.875rem;
    font-weight: 400;
    color: #6b7280;
    text-decoration: none;
    border-bottom: 1px solid #e5e7eb;
    padding-block-end: 0.1rem;
    cursor: pointer;
    transition: color 0.15s ease;
    align-self: flex-start;
  }

  .cs-project-block .cs-live {
    margin-block-start: -0.15rem;
  }

  .cs-live:hover,
  .cs-live:focus-visible {
    color: var(--color-text-primary);
  }

  /* —— Layers —— */
  .cs-stack {
    display: grid;
  }

  .cs-stack > .cs-layer {
    grid-area: 1 / 1;
  }

  .cs-layer {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 420ms;
  }

  .cs-layer.is-leaving {
    opacity: 0;
    transform: translateY(-8px);
    visibility: visible;
    transition:
      opacity 280ms cubic-bezier(0.4, 0, 1, 1),
      transform 280ms cubic-bezier(0.4, 0, 1, 1),
      visibility 0s linear 280ms;
  }

  .cs-layer.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 480ms cubic-bezier(0.22, 1, 0.36, 1) 40ms,
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1) 40ms,
      visibility 0s;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-layer,
    .cs-layer.is-leaving,
    .cs-layer.is-active {
      transition: none;
      transform: none;
    }
  }

  /* —— Mobile —— */
  .cs-m-card .cs-floating-media {
    width: 100%;
    margin: 0 0 0.5rem;
  }

  .cs-m-card .cs-meta {
    margin-block-start: 0.75rem;
  }

  .cs-m-card .cs-label {
    margin-block-start: 1.25rem;
  }

  .cs-m-card .cs-project {
    font-size: clamp(1.75rem, 7vw, 2.5rem);
  }

  .cs-m-card .cs-proof {
    margin-block: 1rem;
  }
</style>
