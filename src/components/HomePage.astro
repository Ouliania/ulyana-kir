---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
import CaseStackList from '../components/CaseStackList.astro';
import InteractiveHoverButton from '../components/InteractiveHoverButton.astro';
import KineticText from '../components/KineticText.astro';
import Interlude from '../components/Interlude.astro';
import ServiceTabsSection from '../components/ServiceTabsSection.astro';
import WorkFlow from '../components/WorkFlow.astro';
import CtaCharacter from '../components/CtaCharacter.astro';
import { cases } from '../data/cases';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';
const featured = cases.filter((c) => c.featured);
const caseBase = locale === 'ru' ? '/ru/cases/' : '/cases/';
const casesIndexHref = caseBase;

const title =
  locale === 'ru'
    ? 'Ulyana Kirp — Сайты для бизнеса'
    : 'Ulyana Kirp — Websites for business goals';
const description = t(locale, 'heroSupport');

const botToken = import.meta.env.PUBLIC_TELEGRAM_BOT_TOKEN || '';
const chatId = import.meta.env.PUBLIC_TELEGRAM_CHAT_ID || '';

const methods = [
  { value: 'telegram', label: 'Telegram' },
  { value: 'whatsapp', label: 'WhatsApp' },
  { value: 'email', label: 'Email' },
  { value: 'linkedin', label: 'LinkedIn' },
  { value: 'facebook', label: locale === 'ru' ? 'MAX' : 'Facebook' },
];
---

<Layout title={title} description={description} lang={locale}>
  <Header locale={locale} />

  <PageShell>
  <main>
    <section id="hero" class="hero">
      <div class="hero-inner">
        <h1 class="hero-title" data-animate="hero">
          <KineticText as="span" class="hero-line" text={t(locale, 'heroTitleLine1')} />
          <KineticText as="span" class="hero-line" text={t(locale, 'heroTitleLine2')} />
        </h1>
        <p class="hero-support" data-animate="hero">
          {t(locale, 'heroSupport')}
        </p>

        <form class="hero-form" id="hero-contact-form" data-animate="hero" data-lang={locale}>
          <div class="hero-form-grid">
            <input
              type="text"
              class="hero-input"
              id="hero-contact"
              name="contact"
              placeholder={locale === 'ru' ? '@telegram, +7999..., email \u0438\u043B\u0438 linkedin' : '@telegram, +7999..., email or linkedin'}
              autocomplete="off"
              required
            />
            <button type="submit" class="btn btn-primary">
              {t(locale, 'discuss')}
            </button>
            <div class="hero-methods" id="hero-methods">
              {methods.map((m) => (
                <label class="hero-method">
                  <input type="radio" name="method" value={m.value} />
                  <span class="method-chip">{m.label}</span>
                </label>
              ))}
            </div>
          </div>
          <div class="hero-form-note" id="hero-form-status"></div>
        </form>
      </div>
    </section>

    <Interlude locale={locale} />

    <section id="services" class="section-block section-block--bleed services">
      <header class="section-head section-head--label">
        <h2 class="type-label">{t(locale, 'whatIDo')}</h2>
      </header>
      <ServiceTabsSection locale={locale} />
    </section>

    <section id="cases" class="section-block section-block--bleed cases-block">
      <header class="section-bridge">
        <h2 class="type-display" data-animate="cases-bridge">
          <span class="cases-bridge-mask">
            <span class="cases-bridge-inner">{t(locale, 'cases')}</span>
          </span>
        </h2>
      </header>
      <CaseStackList locale={locale} cases={featured} caseBase={caseBase} />
    </section>

    <section id="reviews" class="section-block reviews">
      <h2 class="type-display" data-animate="reveal">{t(locale, 'howIWork')}</h2>
      <WorkFlow locale={locale} />
    </section>

    <section id="discuss" class="section-block cta-band">
      <h2 class="cta-heading type-display" data-heading-skip data-animate="reveal">{t(locale, 'ctaHeading')}</h2>
      <div class="cta-hero">
        <!-- Left: doubt button — red side, flat mouth -->
        <div class="cta-side cta-side--left" data-animate="reveal">
          <button type="button" class="btn btn-secondary cta-doubt-btn" data-cta-doubt>
            {t(locale, 'ctaDoubtBtn')}
          </button>
        </div>

        <!-- Center: character -->
        <CtaCharacter />

        <!-- Right: discuss button — green side, big smile -->
        <div class="cta-side cta-side--right" data-animate="reveal">
          <InteractiveHoverButton label={t(locale, 'discuss')} />
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
  </PageShell>

  <script is:inline set:html={`window.__TELEGRAM_BOT_TOKEN__ = ${JSON.stringify(botToken || null)};window.__TELEGRAM_CHAT_ID__ = ${JSON.stringify(chatId || null)};`}></script>
  <script>
    import { initInterlude } from '../scripts/interlude';
    import { initWorkFlowBeams } from '../scripts/animated-beam';
    import { initHeroForm } from '../scripts/hero-form';
    import { initLandingAssemble } from '../scripts/landing-assemble';
    import { initDeepAssemble } from '../scripts/deep-assemble';
    import { initConvAssemble } from '../scripts/conv-assemble';
    import { initStoreAssemble } from '../scripts/store-assemble';
    import { initCtaDoubt } from '../scripts/cta-doubt';
    import { initCtaCharacterMood } from '../scripts/cta-character-mood';
    initInterlude();
    initWorkFlowBeams();
    initHeroForm();
    initLandingAssemble();
    initDeepAssemble();
    initConvAssemble();
    initStoreAssemble();
    initCtaDoubt();
    initCtaCharacterMood();
  </script>
</Layout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
    background: var(--color-surface);
    margin-bottom: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    /* Wide enough for the longest hero line + kinetic hover room */
    max-inline-size: min(100%, 72rem);
    width: 100%;
    margin-inline: auto;
    padding-inline: 1rem;
    padding-block-start: 0;
    padding-block-end: 0;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    font-size: clamp(2.6rem, 1.8rem + 3.8vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    max-width: 100%;
  }

  .hero-title .hero-line {
    font-weight: 500;
    margin-inline: -0.02em;
    line-height: 1.15;
    flex-wrap: wrap;
    text-align: center;
    max-width: 100%;
  }

  .hero-title .kinetic,
  .hero-title .kinetic-letter {
    line-height: 1;
  }

  .hero-title .kinetic-letter {
    margin-inline: -0.015em;
  }

  /*
   * Padding on kinetic hover grows layout width and reflows the line.
   * Hero: scale + weight only — transform does not affect flex sizing.
   */
  .hero-title .kinetic-letter:hover,
  .hero-title .kinetic-letter:has(+ .kinetic-letter:hover),
  .hero-title .kinetic-letter:hover + .kinetic-letter {
    padding-inline: 0;
  }

  .hero-support {
    max-inline-size: 540px;
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Contact form */
  .hero-form {
    width: 100%;
    max-width: 540px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }

  .hero-form-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    width: 100%;
  }

  .hero-form-grid .btn {
    grid-column: 2;
    grid-row: 1 / 3;
    white-space: nowrap;
    align-self: start;
  }

  .hero-form-grid .btn:active {
    transform: scale(0.97);
  }

  .hero-input {
    width: 100%;
    box-sizing: border-box;
    padding: var(--control-pad-block) var(--control-pad-inline);
    font-size: var(--control-font-size);
    line-height: var(--control-line-height);
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text-primary);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-input:focus {
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-blue) 15%, transparent);
  }

  .hero-input::placeholder {
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .hero-methods {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .hero-method {
    cursor: pointer;
    flex: 1 1 0;
    min-width: 0;
  }

  .hero-method input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .method-chip {
    display: block;
    padding: 0.28rem 0.6rem;
    font-size: 0.76rem;
    font-weight: 400;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    text-align: center;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero-method input:checked + .method-chip {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }

  .hero-method:hover .method-chip {
    border-color: var(--color-text-muted);
  }

  .hero-form-note {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    min-height: 1.2em;
    transition: color 0.3s ease;
  }

  .hero-form-note.success {
    color: #2b7a0b;
  }

  .hero-form-note.error {
    color: #d32f2f;
  }

  /* Services / cases: chrome from .section-block; stages stay bleed */
  .services {
    background: transparent;
  }

  .cases-block {
    background: var(--color-surface);
  }

  .cases-more {
    display: flex;
    justify-content: center;
    padding: 0 var(--content-inline) clamp(2.5rem, 5vw, 3.5rem);
  }

  /* === reused from previous === */

  :global(html[lang='ru']) .hero-title {
    line-height: 0.99;
    gap: 0.02em;
  }

  :global(html[lang='ru']) .hero-title .kinetic,
  :global(html[lang='ru']) .hero-title .kinetic-letter {
    line-height: 0.99;
  }

  :global(html[lang='ru']) .hero-support,
  :global(html[lang='ru']) .type-lead {
    line-height: 1.44;
  }

  :global(html[lang='ru']) .reviews .kinetic,
  :global(html[lang='ru']) .cta-inner .kinetic {
    line-height: 1.08;
  }

  .reviews {
    background: transparent;
  }

  .reviews h2 {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cta-band {
    background: transparent;
  }

  .cta-heading {
    text-align: center;
    max-width: 800px;
    margin-inline: auto;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-secondary);
  }

  /* CTA hero: character + two sides */
  .cta-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 1100px;
    margin-inline: auto;
  }

  .cta-side {
    flex: 0 0 auto;
    max-width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .cta-side-label {
    font-size: 0.92rem;
    color: var(--color-text-secondary, #555);
    text-wrap: balance;
    line-height: 1.45;
  }

  .cta-doubt-btn {
    font-size: 0.88rem;
    opacity: 0.8;
  }

  .cta-doubt-btn:hover {
    opacity: 1;
  }

  .cta-side--right {
    margin-inline-start: clamp(1rem, 3vw, 2rem);
  }

  @media (max-width: 699px) {
    .cta-hero {
      flex-direction: column;
      gap: 1.75rem;
    }

    .cta-side {
      max-width: 100%;
    }

    .cta-side--right {
      order: 1;
      margin-inline-start: 0;
    }

    .cta-char {
      order: 2;
    }

    .cta-side--left {
      order: 3;
    }
  }

  /* Tighten hero typography for very small screens (320-400px) */
  @media (max-width: 400px) {
    .hero-title {
      font-size: clamp(2rem, 7vw, 2.4rem);
    }

    .hero-support {
      font-size: 0.95rem;
    }

    .hero-inner {
      padding-inline: 0.75rem;
    }
  }

  /* Mobile: stack form vertically, button full-width */
  @media (max-width: 720px) {
    .hero-form-grid {
      grid-template-columns: 1fr;
    }

    .hero-form-grid .btn {
      grid-column: 1;
      grid-row: auto;
      width: 100%;
      min-width: 0;
      justify-content: center;
      white-space: normal;
    }

    .hero-input {
      min-width: 0;
    }

    .hero-methods {
      min-width: 0;
    }
  }
</style>
