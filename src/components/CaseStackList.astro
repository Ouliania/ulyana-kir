---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { caseLocalized, type CaseStudy } from '../data/cases';

interface Props {
  locale: Locale;
  cases: CaseStudy[];
  caseBase: string;
}

const { locale, cases, caseBase } = Astro.props;
const n = cases.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
/** Case write-ups deferred — hide deep-link until pages ready */
const showCaseDeepLink = false;
/** Sticky overlap only for short stacks (home ≤5; long archive stays static) */
const stickyStack = n > 0 && n <= 5;

function siteHost(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<section
  class:list={['csk', stickyStack && 'csk--sticky']}
  aria-label={t(locale, 'cases')}
>
  {
    cases.map((item, i) => {
      const copy = caseLocalized(item, locale);
      const href = `${caseBase}${item.slug}/`;
      const isPortrait = item.mediaAspect === 'portrait';
      return (
        <article
          class="csk-panel"
          id={item.slug}
          data-animate="case-panel"
          data-media-aspect={item.mediaAspect ?? 'landscape'}
          style={`--csk-z: ${i + 1}`}
        >
          <div
            class:list={[
              'csk-plaque',
              `csk-plaque--${i % 4}`,
              isPortrait && 'csk-plaque--portrait',
            ]}
          >
            <div class="csk-grid">
              {/* Copy first — matches services text-left / viz-right */}
              <div class="csk-copy">
                <!-- Service category only — own block, tags moved under link -->
                <div class="csk-meta">
                  <p class="csk-service">{copy.tag}</p>
                  <p class="csk-index" aria-hidden="true">
                    <span class="csk-index-cur">{pad(i)}</span>
                    <span class="csk-index-sep">/</span>
                    <span>{pad(n - 1)}</span>
                  </p>
                </div>

                {/* Title + live link — tight inner stack */}
                <div class="csk-project-block">
                  <p class="csk-project">{copy.project}</p>
                  {item.url?.startsWith('http') && (
                    <a
                      href={item.url}
                      class="csk-live"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {siteHost(item.url)}
                    </a>
                  )}
                  {item.url?.startsWith('/') && (
                    <a href={item.url} class="csk-live">
                      {t(locale, 'openDemo')}
                    </a>
                  )}
                </div>

                <div class="csk-chips">
                  {item.role.map((role) => (
                    <span class="csk-chip">{role}</span>
                  ))}
                </div>

                <div class="csk-fields">
                  <div class="csk-field">
                    <p class="csk-label">{t(locale, 'theBarrier')}</p>
                    <p class="csk-text">{copy.problem}</p>
                  </div>
                  <div class="csk-field">
                    <p class="csk-label csk-label--done">{t(locale, 'theIntervention')}</p>
                    <ul class="csk-list">
                      {copy.solution.map((step) => (
                        <li class="csk-bullet">{step}</li>
                      ))}
                    </ul>
                  </div>
                </div>

                {/* Result under copy — unconditional for all cases */}
                {copy.metrics.length > 0 && (
                  <div class="csk-proof-block">
                    <p class="csk-result-label">{t(locale, 'result')}</p>
                    <div class="csk-proof">
                      {copy.metrics.map((m) => (
                        <div class="csk-proof-item">
                          <p class="csk-proof-value">{m.value}</p>
                          <p class="csk-proof-desc">{m.label}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {copy.metrics.length === 0 && copy.result.length > 0 && (
                  <div class="csk-result-prose">
                    <p class="csk-result-label">{t(locale, 'result')}</p>
                    {copy.result.map((line) => (
                      <p class="csk-text csk-text--result">{line}</p>
                    ))}
                  </div>
                )}
              </div>

              <div class="csk-visual">
                <div class:list={['csk-media', isPortrait && 'csk-media--portrait']}>
                  {item.video ? (
                    <video
                      class="csk-video"
                      src={item.video}
                      poster={item.poster}
                      muted
                      playsinline
                      loop
                      autoplay
                      preload="metadata"
                    />
                  ) : (
                    <div class="csk-video-ph">{t(locale, 'videoSoon')}</div>
                  )}
                </div>

                {showCaseDeepLink && (
                  <div class="csk-cta-row">
                    <a href={href} class="btn btn-primary">
                      {t(locale, 'caseExplore')}
                      <span aria-hidden="true"> →</span>
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
  {
    stickyStack && (
      <div class="csk-runway" aria-hidden="true" />
    )
  }
</section>

<style>
  /*
   * Whole-case plaque (services-like wash) + smaller video inset.
   * Desktop short stacks: sticky panels ride over each other (наезд).
   */
  .csk {
    --csk-pad: var(--content-inline);
    /* Outer frame around sticky plaque = same as side gutter */
    --csk-frame: var(--csk-pad);
    /* One sticky stop for ∀ panels — ⊥ per-card stepped tops */
    --csk-sticky-top: calc(var(--header-height) + var(--csk-frame));
    /* Same tint family as ServiceTabsSection .st-stage tabs */
    --csk-tint-0: var(--color-blue-tint);
    --csk-tint-1: #c8c4ee;
    --csk-tint-2: var(--color-lime);
    --csk-tint-3: var(--color-yellow);
    /* Saturated accent per plaque — same hue family, higher intensity */
    --csk-accent-0: var(--color-blue);
    --csk-accent-1: var(--color-violet);
    --csk-accent-2: #4caf50;
    --csk-accent-3: #c9a227;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    padding: 0 var(--csk-pad) clamp(1.5rem, 3vw, 2.5rem);
    background: transparent;
  }

  /* Mobile: plaque spans full white-shell width, tighter internal padding */
  @media (max-width: 899px) {
    .csk {
      --csk-pad: 0;
    }

    .csk-plaque {
      padding: clamp(1.25rem, 3vw, 1.75rem);
      border-radius: 0;
      border-left: none;
      border-right: none;
      overflow-x: hidden;
    }

    .csk-panel {
      max-inline-size: 100%;
    }

    .csk-project {
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .csk-text {
      overflow-wrap: break-word;
    }

    .csk-proof-value {
      font-size: clamp(1.75rem, 5vw, 2.25rem);
    }
  }

  .csk-panel {
    max-inline-size: 1400px;
    margin-inline: auto;
    width: 100%;
    z-index: var(--csk-z, 1);
  }

  /* Plaque bg = tint as-is (already pastel wash). ⊥ 55% mix that washed new lime/yellow back to “old” */
  .csk-plaque {
    --csk-tint: var(--csk-tint-0);
    --csk-accent: var(--csk-accent-0);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    /* Equal inset all sides — match former side padding, bump a touch for air */
    padding: clamp(2rem, 2.75vw, 2.5rem);
    background: var(--csk-tint);
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--csk-tint) 55%, transparent);
    box-shadow: none;
  }

  .csk-plaque--0 { --csk-tint: var(--csk-tint-0); --csk-accent: var(--csk-accent-0); }
  .csk-plaque--1 { --csk-tint: var(--csk-tint-1); --csk-accent: var(--csk-accent-1); --csk-result-bg: var(--color-surface); }
  .csk-plaque--2 { --csk-tint: var(--csk-tint-2); --csk-accent: var(--csk-accent-2); --csk-result-bg: var(--color-surface); }
  .csk-plaque--3 { --csk-tint: var(--csk-tint-3); --csk-accent: var(--csk-accent-3); --csk-result-bg: var(--color-surface); }

  @media (min-width: 900px) {
    /*
     * Sticky deck: block (⊥ flex — sticky siblings desync on release).
     * ∀ panels same height; runway after last so hold then release together.
     */
    .csk--sticky {
      --csk-frame-h: calc(100svh - var(--header-height) - 2 * var(--csk-frame));
      display: block;
    }

    .csk--sticky .csk-panel {
      position: sticky;
      top: var(--csk-sticky-top);
      box-sizing: border-box;
      height: var(--csk-frame-h);
      margin-block-end: 80px;
      padding-block-end: 0;
    }

    .csk--sticky .csk-plaque {
      height: 100%;
      min-height: 0;
      overflow: hidden;
    }

    .csk--sticky .csk-runway {
      display: block;
      width: 100%;
      height: 80px;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .csk--sticky {
      display: flex;
      flex-direction: column;
    }

    .csk--sticky .csk-panel {
      position: relative;
      top: auto;
      height: auto;
      margin-block-end: 0;
      padding-block-end: 0;
    }

    .csk--sticky .csk-plaque {
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .csk--sticky .csk-runway {
      display: none;
    }
  }

  .csk-index {
    margin: 0;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: #9ca3af;
    text-align: right;
  }

  .csk-index-cur {
    color: var(--csk-accent);
  }

  .csk-index-sep {
    margin-inline: 0.2rem;
    opacity: 0.6;
  }

  .csk-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 0;
  }

  @media (min-width: 900px) {
    .csk-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem 2.5rem;
      align-items: start;
    }

    .csk--sticky .csk-grid {
      /* Don’t flex-stretch columns — keeps copy tight, video 16:9 */
      flex: 0 1 auto;
      align-items: start;
    }
  }

  .csk-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    /* Gaps on children — outer > inner */
    gap: 0;
    min-width: 0;
  }

  .csk-copy > .csk-proof-block {
    margin-block-start: 0;
    max-inline-size: none;
  }

  .csk-copy > .csk-result-prose {
    margin-block-start: 0;
    max-inline-size: none;
  }

  .csk-visual {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  /* Landscape 16:9 — site screen recordings; ⊥ stretch to square */
  .csk-media {
    position: relative;
    width: 100%;
    max-inline-size: none;
    aspect-ratio: 16 / 9;
    flex: none;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: #0f1218;
    box-shadow: 0 20px 48px -18px rgba(0, 0, 0, 0.16);
  }

  /*
   * Portrait phone / Mini App — source ≈ 500×1080.
   * Need definite width: video is position:absolute, so width:auto → 0×0.
   */
  .csk-media--portrait {
    width: min(16rem, 58vw);
    aspect-ratio: 9 / 19.5;
    height: auto;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .csk-plaque--portrait .csk-grid {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 1fr);
      align-items: stretch;
    }

    .csk-plaque--portrait .csk-visual {
      align-items: center;
      justify-content: center;
      align-self: stretch;
      min-height: 0;
    }

    .csk-media--portrait {
      /* Fill visual col — Result moved to copy */
      width: min(20rem, 88%);
      height: auto;
      aspect-ratio: 9 / 19.5;
      max-block-size: min(36rem, calc(var(--csk-frame-h, 80svh) * 0.82));
    }

    .csk--sticky .csk-plaque--portrait .csk-media--portrait {
      flex: 1 0 0;
      max-block-size: none;
      width: auto;
      height: auto;
      max-inline-size: min(20rem, 88%);
      aspect-ratio: 9 / 19.5;
    }
  }

  .csk-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .csk-video-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
  }

  /* Outer: service/tags → title (largest step in copy) */
  .csk-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    width: 100%;
    margin-block-end: 0.5rem;
  }

  /* Title + link — tight inner; then smaller step to Barrier */
  .csk-project-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-block-end: 1.15rem;
  }

  .csk-service {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text-muted);
    margin: 0;
    min-width: 0;
  }

  .csk-project {
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 1.2rem + 1.1vw, 2.15rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .csk-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    flex-shrink: 0;
    margin-block-end: 2.25rem;
  }

  .csk-chip {
    padding: 0.25rem 0.6rem !important;
    background: rgba(255, 255, 255, 0.75) !important;
    color: var(--csk-accent) !important;
    font-size: 0.72rem !important;
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
    border-radius: var(--radius-default) !important;
    border: none !important;
  }

  .csk-live {
    font-size: 0.9rem;
    color: var(--csk-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .csk-fields {
    display: grid;
    gap: 1.5rem;
    max-inline-size: none;
    margin-block-end: 2.25rem;
  }

  @media (min-width: 768px) {
    .csk-fields {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .csk-label {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--csk-accent);
    font-weight: 500 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
    margin: 0 0 0.35rem;
  }

  .csk-label--done {
    color: var(--csk-accent);
    font-weight: 500 !important;
  }

  .csk-text {
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.35;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .csk-text--result {
    margin-block-end: 0.35rem;
  }

  .csk-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .csk-bullet {
    position: relative;
    padding-inline-start: 1.1rem;
    font-size: 0.98rem;
    line-height: 1.2;
    color: var(--color-text-secondary);
  }

  .csk-bullet::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--csk-accent);
    box-shadow:
      6px 0 0 var(--csk-accent),
      12px 0 0 var(--csk-accent);
    transform: scale(0.55);
  }

  .csk-result-label {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--csk-accent);
    font-weight: 400 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
    margin: 0 0 0.35rem;
  }

  .csk-proof-block,
  .csk-result-prose {
    box-sizing: border-box;
    width: 100%;
    max-inline-size: none;
    padding: 0.625rem 0 0;
    background: transparent;
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--csk-tint) 88%, var(--color-text-primary));
    border-radius: 0;
  }

  .csk-proof-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.325rem;
  }

  .csk-proof {
    display: flex;
    gap: 1.5rem;
    padding-block: 0;
    width: 100%;
  }

  .csk-proof-item {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .csk-proof-value {
    font-family: var(--font-body);
    font-size: clamp(2.25rem, 2.6vw, 2.85rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--csk-accent);
  }

  .csk-proof-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .csk-cta-row {
    margin-block-start: 0.25rem;
    width: 100%;
  }
</style>
