---
interface Props {
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  label: string;
}

const {
  href,
  target,
  rel,
  type = 'button',
  class: className = '',
  label,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const extraAttrs = href
  ? { href, target, rel }
  : { type, 'data-contact-popup': '' };
---

<Tag
  class:list={['btn', 'btn-primary', className]}
  {...extraAttrs}
>
  {label}
</Tag>
