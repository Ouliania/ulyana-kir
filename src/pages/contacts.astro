---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { t } from '../i18n/ui';

// EN version of contacts page
const locale = 'en';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Ulyana Kirpichnikova",
  "description": "Get in touch to discuss your website, audit, or design project. Telegram, WhatsApp, email — I reply within the day.",
  "url": "https://ulyanaweb.ru/contacts",
  "mainEntity": {
    "@type": "ProfessionalService",
    "name": "Ulyana Kirpichnikova",
    "email": "ouliana14@icloud.com",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "RU"
    }
  }
};
---

<Layout 
  title="Contact Ulyana Kirpichnikova — Let's Discuss Your Project"
  description="Get in touch to discuss your website, audit, or design project. Telegram, WhatsApp, email — I reply within the day."
  schema={contactSchema}
  lang={locale}
>
  <Header locale={locale} />

  <PageShell>
  <main class="contacts-main section-padding">
    <Breadcrumbs locale={locale} items={[{ label: t(locale, 'navContacts') }]} />
    <div class="container">
      <div class="contacts-header">
        <h1 class="contacts-title">Get in touch</h1>
        <p class="contacts-subtitle">I reply within the day. Let's discuss your project, answer your questions, and find the best solution together.</p>
      </div>

      <div class="grid-2 contacts-grid">
        {/* Left Column: Real Contact Links */}
        <div class="contacts-info">
          <div class="info-block">
            <h3 class="info-label">Messengers</h3>

            <a href="https://t.me/UlyanaKir" target="_blank" rel="noopener noreferrer" class="contact-link telegram">
              <div>
                <span class="link-title">Telegram</span>
                <span class="link-val">@UlyanaKir</span>
                <span class="link-desc">Quick replies throughout the day</span>
              </div>
            </a>

            <a href="https://wa.me/UlyanaKirp" target="_blank" rel="noopener noreferrer" class="contact-link whatsapp">
              <div>
                <span class="link-title">WhatsApp</span>
                <span class="link-val">@UlyanaKirp</span>
                <span class="link-desc">For project discussions</span>
              </div>
            </a>

            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" class="contact-link facebook">
              <div>
                <span class="link-title">Facebook</span>
                <span class="link-val">Open profile</span>
                <span class="link-desc">If something didn't work above</span>
              </div>
            </a>
          </div>

          <div class="info-block">
            <h3 class="info-label">Email</h3>
            <a href="mailto:ouliana14@icloud.com" class="contact-link email">
              <div>
                <span class="link-title">Email</span>
                <span class="link-val">ouliana14@icloud.com</span>
                <span class="link-desc">The classic way</span>
              </div>
            </a>
          </div>
        </div>

        {/* Right Column: Schedule */}
        <div class="contacts-form-container info-block">
          <h3 class="info-label">Schedule & response time</h3>
          <div class="glass-card info-card">
            <div class="info-split-grid">
              <div class="info-split-item">
                <h3 class="info-card-title flex-align">
                  Working hours
                </h3>
                <div class="hours-list">
                  <div class="hours-row">
                    <span>Mon — Fri</span>
                    <strong>10:00 — 19:00</strong>
                  </div>
                  <div class="hours-row output-disabled">
                    <span>Sat — Sun</span>
                    <span class="text-muted">Day off</span>
                  </div>
                </div>
                <p class="info-small">But I do reply to messages throughout the day — sometimes evenings too.</p>
              </div>

              <div class="info-split-item">
                <h3 class="info-card-title flex-align">
                  Response time
                </h3>
                <p class="info-card-desc">Usually within 2–4 hours. If I don't reply immediately — I'm working on a project, but I will see your message.</p>
                <div class="status-online">
                  <span>Currently available</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  </PageShell>
</Layout>

<style>
  .contacts-main {
    padding-block-start: clamp(2rem, 4vw, 3rem);
    min-block-size: 80vh;
  }

  .contacts-header {
    max-inline-size: 600px;
    margin-block-end: 4rem;
  }

  .contacts-title {
    font-size: var(--fs-h1);
    margin-block-end: 1rem;
    color: var(--color-text-primary);
  }

  .contacts-subtitle {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .contacts-grid {
    gap: 4rem;
    align-items: flex-start;
  }

  .contacts-info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-label {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-default);
    border: 1px solid var(--color-border);
    transition: border-color 0.15s ease, background-color 0.15s;
  }

  .contact-link:hover {
    border-color: var(--color-text-primary);
    background-color: var(--color-bg-subtle);
  }

  .link-icon {
    width: 48px;
    height: 48px;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-default);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .link-title {
    display: block;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .link-val {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-block-start: 0.15rem;
  }

  .link-desc {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-block-start: 0.1rem;
  }

  /* Info Split Cards */
  .info-card {
    background: transparent;
    border-color: var(--color-border);
    border-radius: var(--radius-default) !important;
    box-shadow: none !important;
  }

  .info-split-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .info-card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-block-end: 1rem;
  }

  .flex-align {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-end: 1rem;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
  }

  .hours-row.output-disabled {
    color: var(--color-text-muted);
  }

  .info-small {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .info-card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-block-end: 1.5rem;
  }

  .status-online {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .dot-online {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent-text);
    border-radius: var(--radius-default);
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
