---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageShell from '../../components/PageShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t } from '../../i18n/ui';

// Fetch and sort blog posts
const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function getReadTime(body: string = ''): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const allTags = Array.from(
  new Set(posts.flatMap(post => post.data.tags || []))
).sort();

const title = "Блог Ульяны Кирпичниковой | Мысли о сайтах, конверсиях и дизайне";
const description = "Личный блог про веб-разработку, копирайтинг, конверсии сайтов, оптимизацию и продвижение в поисковых и ИИ-системах.";
---

<Layout title={title} description={description} isBlog={true}>
  <Header />

  <PageShell>
  <main class="blog-main section-padding">
    <Breadcrumbs locale="ru" items={[{ label: t('ru', 'blog') }]} />
    <div class="container">
      <div class="blog-header">
        <h1 class="blog-title">Блог</h1>
        <p class="blog-subtitle">Мысли, инсайты и разборы о создании сайтов, которые приносят прибыль.</p>
      </div>

      <div class="blog-layout">
        <!-- Left Sidebar Filter -->
        <aside class="blog-sidebar">
          <h3 class="sidebar-title">Рубрики</h3>
          <ul class="tag-filters-list">
            <li>
              <button class="blog-tag-filter is-active" data-tag-filter="all">
                Все статьи
              </button>
            </li>
            {allTags.map(tag => (
              <li>
                <button class="blog-tag-filter" data-tag-filter={tag}>
                  {tag}
                </button>
              </li>
            ))}
          </ul>
        </aside>

        <!-- Right Content Feed -->
        <div class="blog-content">
          {posts.length === 0 ? (
            <div class="glass-card text-center" style="padding: 4rem;">
              <p>В блоге пока нет опубликованных статей. Загляните позже!</p>
            </div>
          ) : (
            <div class="grid-2 blog-grid">
              {posts.map(post => (
                <article class="glass-card blog-card" data-tags={post.data.tags.join(',')}>
                  <div class="blog-card-meta">
                    <div class="blog-card-date-time">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('ru-RU', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric'
                        })}
                      </time>
                      <span class="meta-separator">/</span>
                      <span class="read-time" title="Время чтения">
                        <svg class="meta-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        {getReadTime(post.body)} мин
                      </span>
                    </div>
                    <div class="blog-card-tags">
                      {post.data.tags.map(tag => (
                        <span class="blog-tag">{tag}</span>
                      ))}
                    </div>
                  </div>
                  
                  <h2 class="blog-card-title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  
                  <p class="blog-card-desc">{post.data.description}</p>
                  
                  <a href={`/blog/${post.id}/`} class="read-more-link">
                    Читать статью ➔
                  </a>
                </article>
              ))}
            </div>
          )}
        </div>
      </div>

<script>
  const tagButtons = document.querySelectorAll('[data-tag-filter]');
  const blogCards = document.querySelectorAll('.blog-card');

  tagButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filterTag = button.getAttribute('data-tag-filter');

      // Update active button state
      tagButtons.forEach(btn => btn.classList.remove('is-active'));
      button.classList.add('is-active');

      // Filter cards
      blogCards.forEach(card => {
        const cardTagsAttr = card.getAttribute('data-tags') || '';
        const cardTags = cardTagsAttr.split(',').map(t => t.trim());

        if (filterTag === 'all' || cardTags.includes(filterTag)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
    </div>
  </main>

  <Footer />
  </PageShell>
</Layout>

<style>
  .blog-main {
    padding-block-start: clamp(2rem, 4vw, 3rem);
    min-block-size: 80vh;
  }

  /* Blog Layout structure */
  .blog-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .blog-layout {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
  }

  .blog-sidebar {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .blog-sidebar {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      max-height: calc(100vh - var(--header-height) - 4rem);
      overflow-y: auto;
    }
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 600;
    margin-block-end: 1rem;
    text-transform: uppercase;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  @media (max-width: 1023px) {
    .sidebar-title {
      display: none;
    }
  }

  .tag-filters-list {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
    list-style: none;
    padding-left: 0;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
  }

  .tag-filters-list::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 1024px) {
    .tag-filters-list {
      flex-direction: column;
      gap: 0.5rem;
      overflow-x: visible;
      padding-bottom: 0;
    }
  }

  .blog-tag-filter {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-default);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    text-align: left;
    width: 100%;
    transition: all 0.2s ease;
  }

  @media (max-width: 1023px) {
    .blog-tag-filter {
      width: auto;
    }
  }

  .blog-tag-filter:hover {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
  }

  .blog-tag-filter.is-active {
    background: var(--color-blue-tint);
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .blog-header {
    max-inline-size: 700px;
    margin-inline: auto;
    text-align: center;
    margin-block-end: 5rem;
    margin-block-start: 1rem;
  }

  .blog-title {
    font-size: var(--fs-h1);
    margin-block-end: 1rem;
    color: var(--color-text-primary);
  }

  .blog-subtitle {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.25rem 2rem 2rem 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    height: 100%;
    justify-content: flex-start;
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover {
    border-color: var(--color-text-primary);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px -10px color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }

  @media (max-width: 640px) {
    .blog-card {
      padding: 1.5rem 1.25rem;
      gap: 1.25rem;
    }
  }

  .blog-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    padding-bottom: 1rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .blog-card-date-time {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-separator {
    color: var(--color-border);
  }

  .read-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-muted);
  }

  .meta-icon {
    display: inline-block;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .blog-card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-tag {
    background: var(--color-blue-tint);
    border: 1px solid transparent;
    color: var(--color-blue);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-default);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .blog-card-title {
    font-size: var(--fs-h3);
    line-height: 1.35;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    word-break: break-word;
  }

  .blog-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .blog-card-title a:hover {
    color: var(--color-blue);
  }

  .blog-card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .read-more-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-blue);
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .read-more-link:hover {
    color: var(--color-accent-hover);
    transform: translateX(4px);
  }
</style>
