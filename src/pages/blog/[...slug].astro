---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageShell from '../../components/PageShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// filter headings to H2 depth for a clean table of contents
const tocHeadings = headings.filter(h => h.depth === 2);

const canonicalPostUrl = Astro.site ? new URL(`/blog/${entry.id}/`, Astro.site).toString() : `https://ulyanaweb.ru/blog/${entry.id}/`;
const imageUrl = entry.data.image
  ? (Astro.site ? new URL(entry.data.image, Astro.site).toString() : `https://ulyanaweb.ru${entry.data.image}`)
  : (Astro.site ? new URL('/og-image.png', Astro.site).toString() : 'https://ulyanaweb.ru/og-image.png');

// Related posts: find posts sharing tags, or take recent ones
const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.id !== entry.id);

const relatedPosts = allPosts
  .map(p => {
    const sharedTags = p.data.tags.filter(t => entry.data.tags.includes(t)).length;
    return { post: p, score: sharedTags };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 2)
  .map(item => item.post);

// Specific JSON-LD Schema for BlogPosting (highly optimized for search/AI crawlers)
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": imageUrl,
  "datePublished": entry.data.pubDate.toISOString(),
  "dateModified": entry.data.pubDate.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalPostUrl
  },
  "author": {
    "@type": "Person",
    "name": "Ульяна Кирпичникова",
    "url": Astro.site ? Astro.site.toString() : "https://ulyanaweb.ru"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ульяна Кирпичникова",
    "logo": {
      "@type": "ImageObject",
      "url": "https://ulyanaweb.ru/favicon.ico"
    }
  }
};
---

<Layout 
  title={`${entry.data.title} | Блог Ульяны Кирпичниковой`} 
  description={entry.data.description}
  image={imageUrl}
  schema={blogSchema}
  isBlog={true}
>
  <Header />

  <PageShell>
  <main class="post-main section-padding">
    <Breadcrumbs
      locale="ru"
      items={[
        { label: t('ru', 'blog'), href: '/blog/' },
        { label: entry.data.title },
      ]}
    />
    <article class="container post-container">
      <header class="post-header">
        <div class="post-meta">
          <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString('ru-RU', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <div class="post-tags">
            {entry.data.tags.map(tag => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        </div>
        
        <h1 class="post-title">{entry.data.title}</h1>
      </header>

      {tocHeadings.length > 0 && (
        <nav class="post-toc">
          <h4 class="toc-title">Содержание статьи</h4>
          <ul class="toc-list">
            {tocHeadings.map(h => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {relatedPosts.length > 0 && (
        <section class="related-posts">
          <h3 class="related-title">Читайте также</h3>
          <div class="related-grid">
            {relatedPosts.map(rel => (
              <a href={`/blog/${rel.id}/`} class="related-card">
                <span class="related-card-title">{rel.data.title}</span>
                <p class="related-card-desc">{rel.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <BlogCTA />
    </article>
  </main>

  <Footer />
  </PageShell>
</Layout>

<style>
  .post-main {
    padding-block-start: clamp(2rem, 4vw, 3rem);
    min-block-size: 80vh;
  }

  .post-container {
    max-inline-size: 800px;
  }

  .back-link {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    display: inline-block;
    margin-block-end: 2rem;
    transition: color 0.15s ease, transform 0.15s;
  }

  .back-link:hover {
    color: var(--color-accent-text);
    transform: translateX(-4px);
  }

  .post-header {
    margin-block-end: 3rem;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-block-end: 1rem;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
  }

  .post-tag {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-default);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .post-title {
    font-size: var(--fs-h2);
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .post-toc {
    background: var(--color-bg-subtle);
    border-left: 1px solid var(--color-text-primary);
    padding: 1.5rem 2rem;
    margin-block-start: 1rem;
    margin-block-end: 3rem;
    max-inline-size: 680px;
    width: 100%;
  }

  .toc-title {
    font-size: 0.85rem;
    font-weight: 500;
    margin-block-end: 1.25rem;
    text-transform: uppercase;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style-type: none;
    padding-inline-start: 0;
  }

  .toc-list li {
    font-size: 1.05rem;
    line-height: 1.45;
    position: relative;
    padding-left: 1.25rem;
  }

  .toc-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  .toc-list a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-list a:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Prose Styles for rendering markdown content */
  .prose {
    max-inline-size: 680px;
    width: 100%;
  }

  .prose :global(p) {
    font-size: var(--fs-body);
    line-height: 1.7;
    margin-block-end: 1.5rem;
    color: var(--color-text-secondary);
  }

  .prose :global(a) {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .prose :global(a:hover) {
    color: var(--color-text-secondary);
    text-decoration-color: var(--color-accent-text);
  }

  .prose :global(h2) {
    font-size: var(--fs-h3);
    margin-block-start: 2.5rem;
    margin-block-end: 1rem;
    color: var(--color-text-primary);
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-block-start: 2rem;
    margin-block-end: 1rem;
    color: var(--color-text-primary);
  }

  .prose :global(ul), .prose :global(ol) {
    margin-block-end: 1.5rem;
    padding-inline-start: 1.5rem;
  }

  .prose :global(li) {
    margin-block-end: 0.5rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .prose :global(ul) {
    list-style-type: disc;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(blockquote) {
    border-left: 1px solid var(--color-text-primary);
    padding-inline-start: 1.5rem;
    margin-inline: 0;
    margin-block: 2rem;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .prose :global(code) {
    font-family: monospace;
    background: var(--color-bg-subtle);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-default);
    font-size: 0.9em;
    color: var(--color-text-primary);
  }

  .prose :global(pre) {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: var(--radius-default);
    overflow-x: auto;
    margin-block-end: 2rem;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.9rem;
  }

  /* Table Styles for Markdown Content */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block-start: 1rem;
    margin-block-end: 2rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  .prose :global(th) {
    font-family: var(--font-heading);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-text-primary);
    color: var(--color-text-primary);
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    vertical-align: top;
  }

  .prose :global(tr:hover td) {
    color: var(--color-text-primary);
    background-color: var(--color-bg-subtle);
  }

  /* Related Posts Block */
  .related-posts {
    margin-block-start: 4rem;
    margin-block-end: 3rem;
    padding-block-start: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-title {
    font-size: var(--fs-h3);
    color: var(--color-text-primary);
    margin-block-end: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-default);
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .related-card:hover {
    border-color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  .related-card-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.35;
  }

  .related-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
