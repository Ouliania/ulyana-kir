---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---

<Layout 
  title="404 — Page not found / Страница не найдена"
  description="Lost in the funnel? The page you requested doesn't exist."
  lang="en"
>
  <Header locale="en" />

  <PageShell>
    <main class="error-main section-padding">
      <div class="error-container">
        <div class="error-badge">404</div>
        
        <div class="error-card">
          <!-- English Version (Default) -->
          <div data-lang-content="en" class="lang-block">
            <h1 class="error-title">Lost in the funnel?</h1>
            <p class="error-text">
              Either this page was washed away by bad copywriting, or your AI assistant made up this URL. Currently, this page's conversion rate is exactly 0%.
            </p>
            <p class="error-text error-text--muted">
              Let's get back to civilized territory and build a better website.
            </p>
            <a href="/" id="home-link-en" class="btn btn-primary error-btn">
              Back to Home
            </a>
          </div>

          <!-- Russian Version -->
          <div data-lang-content="ru" class="lang-block">
            <h1 class="error-title">Потерялись в воронке?</h1>
            <p class="error-text">
              Возможно, эту страницу смыло плохим копирайтингом, или ваш ИИ-ассистент просто выдумал эту ссылку. В любом случае, конверсия этой страницы сейчас ровно 0%.
            </p>
            <p class="error-text error-text--muted">
              Давайте вернемся на обитаемую территорию и построим воронку получше.
            </p>
            <a href="/ru/" id="home-link-ru" class="btn btn-primary error-btn">
              Вернуться на главную
            </a>
          </div>
        </div>
      </div>
    </main>

    <Footer locale="en" />
  </PageShell>
</Layout>

<script is:inline>
  // Simple client-side routing to adapt locale of the 404 template dynamically
  const isRu = window.location.pathname.startsWith('/ru/') || window.location.pathname === '/ru';
  
  if (isRu) {
    document.querySelectorAll('[data-lang-content="en"]').forEach(el => el.style.display = 'none');
    document.querySelectorAll('[data-lang-content="ru"]').forEach(el => el.style.display = 'block');
    
    // Dynamically adjust header and footer locale if possible
    document.documentElement.lang = 'ru';
    document.title = '404 — Страница не найдена';
  } else {
    document.querySelectorAll('[data-lang-content="ru"]').forEach(el => el.style.display = 'none');
    document.querySelectorAll('[data-lang-content="en"]').forEach(el => el.style.display = 'block');
  }
</script>

<style>
  .error-main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 70vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .error-container {
    max-inline-size: 540px;
    width: 100%;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .error-badge {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 10vw, 7.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-blue);
    letter-spacing: -0.02em;
    user-select: none;
  }

  .error-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 4vw, 2.5rem);
    width: 100%;
    box-shadow: 0 4px 20px -8px color-mix(in srgb, var(--color-text-primary) 5%, transparent);
  }

  .lang-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Default hiding state to let inline JS switch cleanly */
  [data-lang-content="ru"] {
    display: none;
  }

  .error-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0;
  }

  .error-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .error-text--muted {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .error-btn {
    margin-block-start: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding-inline: 2rem;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius-button);
  }
</style>
